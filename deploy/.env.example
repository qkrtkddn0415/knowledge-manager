APP_NAME=Second Brain
ENVIRONMENT=production

# Use the named Docker volume by default. Set to ./deploy/runtime to deploy
# the existing local database and source files after running prepare-runtime.ps1.
SECOND_BRAIN_RUNTIME_PATH=second_brain_runtime
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_VECTOR_STORE_ID=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_EXTRACTION_WORKERS=3
OPENAI_EXTRACTION_MAX_OUTPUT_TOKENS=20000
OPENAI_EXTRACTION_GAP_PASS=true
OPENAI_EXTRACTION_GAP_MIN_CHARS=9000
OPENAI_EXTRACTION_GAP_MIN_CONCEPTS=8

AGENT_MAX_TURNS=30
AGENT_MAX_TOOL_CALLS=30
AGENT_MAX_CALLS_PER_CYCLE=8
AGENT_RUN_TIMEOUT_SECONDS=300
AGENT_MAX_OUTPUT_CHARS=24000
AGENT_ALLOW_WEB_SEARCH=false
MAX_DOCUMENT_BYTES=536870912
CHUNK_SIZE_CHARS=24000
CHUNK_OVERLAP_CHARS=500
